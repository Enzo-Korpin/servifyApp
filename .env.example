# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Comma-separated allowed origins for CORS (Flutter app + admin dashboard).
CLIENT_ORIGINS=http://localhost:5174,http://localhost:3000

# ─── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=replace-me-with-a-long-random-string

# ─── MongoDB ───────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/servify

# ─── Redis ─────────────────────────────────────────────────────────────────
# Set REDIS_ENABLED=false to fully disable Redis. The app still runs;
# cache helpers no-op, the rate-limit middleware fails open, and the
# BullMQ worker exits cleanly.
REDIS_ENABLED=true
# Preferred: a single URL (works for managed Redis providers).
# REDIS_URL=redis://127.0.0.1:6379
# Or, the discrete vars used by docker-compose:
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=

# ─── Arcjet (existing rate-limit / bot detection) ──────────────────────────
ARCJET_KEY=
ARCJET_ENV=development

# ─── Cloudinary ────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Mailtrap / Resend ─────────────────────────────────────────────────────
MAILTRAP_TOKEN=
RESEND_API_KEY=

# ─── Google Sign-In ────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ─── Admin seeder (npm run seed:admin) ─────────────────────────────────────
ADMIN_EMAIL=admin@servify.local
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_FULL_NAME=Servify Admin
