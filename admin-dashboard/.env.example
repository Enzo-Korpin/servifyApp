# Base URL of the Servify backend (used by axios in production builds).
# In development you can leave this empty and rely on the Vite proxy below.
VITE_API_BASE_URL=

# Dev-only: the Vite dev server proxies /api/* to this target so cookies just work.
VITE_API_PROXY=http://localhost:5000

# Port for `npm run dev`
VITE_DEV_PORT=5174
